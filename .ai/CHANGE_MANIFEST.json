{
  "version": 1,
  "task": "normal-development",
  "status": "template",
  "owner": "ai-agent",
  "allowedPaths": [
    ".ai/**",
    ".github/**",
    "scripts/**",
    "package.json",
    "packages/**",
    "apps/**",
    "docs/**",
    "README.md",
    "*.md"
  ],
  "forbiddenPaths": [
    ".env",
    ".env.*",
    "**/node_modules/**",
    "**/dist/**",
    "**/.next/**",
    "**/target/**"
  ],
  "requiredChecks": [
    "ai:audit:strict",
    "ai:evidence:compare",
    "typecheck",
    "lint",
    "test",
    "build"
  ],
  "preserve": [
    "existing public APIs unless explicitly migrated",
    "authorization boundaries",
    "database migration history",
    "existing CI gates"
  ],
  "highRiskPathsRequireExplicitApproval": [
    "apps/mobile/prisma/**",
    "apps/mobile/src/app/api/auth/**",
    "apps/mobile/src/app/api/payments/**",
    "apps/mobile/src/app/api/uploads/**",
    "apps/mobile/src/middleware.*",
    "**/*security*.*"
  ]
}
