{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KINETIXFITT",
  "version": "1.0.0",
  "identifier": "com.kinetixfitt.desktop",
  "build": {
    "devUrl": "http://localhost:3001",
    "frontendDist": "https://app.kinetixfitt.com"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KINETIXFITT",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#080808"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "icon": ["../../mobile/public/icons/icon-512.png"],
    "windows": {
      "nsis": {
        "installMode": "perUser",
        "compression": "high",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
