# KinetixFitt — configuración local / producción
# Nunca commitear credenciales reales.

# PostgreSQL / Supabase
# Runtime puede usar el pooler; Prisma migrations/admin deben usar la conexión DIRECTA.
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@db.[REF].supabase.co:5432/postgres"

# Auth
JWT_SECRET="genera-un-secreto-aleatorio-de-32-o-mas-caracteres"
NODE_ENV=production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d
TRUST_PROXY_HEADERS=true
KINETIX_INTERNAL_API_SECRET="genera-otro-secreto-aleatorio-de-32-o-mas-caracteres"
BACKUP_ADMIN_USER_IDS="cuid-admin-1,cuid-admin-2"

# URLs
NEXT_PUBLIC_APP_URL=https://kinetixfitt.com
NEXT_PUBLIC_WEB_URL=https://kinetixfitt.com
API_URL=https://api.kinetixfitt.com
WEB_URL=https://app.kinetixfitt.com
MOBILE_DEEP_LINK=kinetixfitt://
# URL pública de la app Next.js que cargará Capacitor.
CAPACITOR_SERVER_URL=https://app.kinetixfitt.com

# Soporte por WhatsApp (solo dígitos, incluyendo código de país; vacío = ocultar accesos WhatsApp)
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# AI provider compatible con OpenAI
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
AI_API_KEY=""
OPENAI_API_KEY=""
GLM_API_KEY=""

# Stripe
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_CHECKOUT_CURRENCY=ARS

# Mercado Pago
MP_ACCESS_TOKEN="APP_USR-..."
MP_WEBHOOK_SECRET="..."
NEXT_PUBLIC_MP_PUBLIC_KEY="APP_USR-..."

# Email: Resend > SMTP
RESEND_API_KEY="re_..."
EMAIL_FROM="KINETIXFITT <noreply@kinetixfitt.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_PASSWORD=""
SMTP_FROM="KINETIXFITT <noreply@kinetixfitt.com>"

# Storage / backups
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 3 * * *"
BACKUP_DIR=""
BACKUP_S3_BUCKET="kinetixfitt-backups-prod"
ASSETS_S3_BUCKET="kinetixfitt-assets-prod"
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Rate limiting / Redis (producción: obligatorio)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
REDIS_URL=""

# Push
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Observability
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT=production
LOG_LEVEL=info
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Seguridad
CSP_REPORT_URI=/api/csp-report
