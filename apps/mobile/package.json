{
  "name": "kinetixfitt",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "verify": "powershell -ExecutionPolicy Bypass -File ../../scripts/verify-platforms.ps1",
    "verify:production": "node ../../scripts/verify-production-env.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "echo 'PROHIBIDO migrate dev (pooler sin shadow DB). Flujo en .env.example + scripts/ad-hoc/pg-apply.cjs' && exit 1",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "backup": "node scripts/backup.js",
    "test:stats": "tsx tests/stats.test.ts",
    "test:voice": "tsx tests/voice-engine.test.ts",
    "test:core": "tsx tests/program-edit.test.ts",
    "test:domain": "tsx tests/domain.test.ts",
    "test:security-unit": "tsx tests/reset-hash.test.ts",
    "test:notifications": "tsx tests/notification-validation.test.ts",
    "test:unit": "npm run test:stats && npm run test:voice && npm run test:core && npm run test:domain && npm run test:security-unit && npm run test:notifications",
    "test:security": "tsx tests/security.test.ts",
    "test": "npm run test:unit && npm run test:security",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "postinstall": "prisma generate",
    "prepare": "husky",
    "desktop:dev": "cross-env NODE_ENV=development electron electron/main.js",
    "desktop:build": "electron-builder -c electron/builder.json",
    "desktop:build:win": "electron-builder -c electron/builder.json --win nsis --publish never",
    "desktop:build:mac": "electron-builder -c electron/builder.json --mac dmg --publish never",
    "native:add:android": "npx cap add android",
    "native:add:ios": "npm install @capacitor/ios@8.5.2 --no-save --package-lock=false && npx cap add ios",
    "native:sync": "npx cap sync",
    "native:build:android": "npm run native:add:android && npx cap sync android && cd android && gradlew.bat assembleDebug",
    "native:build:ios": "npm run native:add:ios && npx cap sync ios && xcodebuild -workspace ios/App/App.xcworkspace -scheme App -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO build",
    "analyze": "cross-env ANALYZE=true next build",
    "analyze:open": "cross-env ANALYZE=true next build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@sentry/nextjs": "^10.74.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.109.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/three": "^0.186.0",
    "@types/web-push": "^3.6.4",
    "@upstash/ratelimit": "^2.1.0",
    "@upstash/redis": "^1.38.4",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.15.0",
    "jose": "^6.0.11",
    "lucide-react": "^0.511.0",
    "next": "16.3.5",
    "posthog-js": "^1.430.3",
    "prisma": "^6.8.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.88.0",
    "recharts": "^2.15.4",
    "sonner": "^2.0.8",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.3.0",
    "uuid": "^14.0.2",
    "web-push": "^3.6.7",
    "zod": "^3.25.76",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@next/bundle-analyzer": "^15.5.24",
    "@next/eslint-plugin-next": "^16.3.5",
    "@playwright/test": "^1.63.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.21",
    "@types/nodemailer": "^6.4.24",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.2",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "electron": "44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.27.0",
    "eslint-config-next": "15.5.24",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0"
  }
}
